{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Postal code location",
  "type": "object",
  "required": ["country", "country abbreviation", "post code", "places"],
  "additionalProperties": false,
  "properties": {
    "country":              { "type": "string", "minLength": 1 },
    "country abbreviation": { "type": "string", "minLength": 1 },
    "post code":            { "type": "string", "minLength": 1 },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["place name", "longitude", "latitude", "state", "state abbreviation"],
        "additionalProperties": false,
        "properties": {
          "place name":         { "type": "string", "minLength": 1 },
          "state":              { "type": "string", "minLength": 1 },
          "state abbreviation": { "type": "string", "minLength": 1 },

          "longitude":          { "type": "string", "minLength": 1 },
          "latitude":           { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
